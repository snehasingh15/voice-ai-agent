# ──────────────────────────────────────────────────────────────────────────
# Voice AI – Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────

# Core AI APIs
DEEPGRAM_API_KEY=           # Speech-to-Text: https://deepgram.com
GROQ_API_KEY=               # LLM inference (Llama-3 / Mixtral): https://console.groq.com
GEMINI_API_KEY=             # Multimodal vision + embeddings: https://aistudio.google.com

# LLM model overrides (optional)
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_TEXT_MODEL=gemini-3.7-flash

# MongoDB Atlas
MONGODB_URI=                # e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=voice_ai_db

# Distributed Session Cache (optional – falls back to MongoDB TTL collection)
REDIS_URL=                  # e.g. redis://localhost:6379 or rediss://user:pass@host:port

# Security & Auth
ADMIN_PASSWORD=             # Admin dashboard password (also used for JWT login)
JWT_SECRET_KEY=             # Strong random secret for JWT signing (change in production!)
ACCESS_TOKEN_EXPIRE_HOURS=24

# Telephony – Exotel
TELEPHONY_PROVIDER=exotel
PUBLIC_BASE_URL=            # Your public backend URL, e.g. https://voice-ai-backend.onrender.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_STREAM_URL=

# Telephony – Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STREAM_URL=
